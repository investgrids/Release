# Template for /opt/marketripple/.env on the VPS. NAMES ONLY: real values are copied over a private channel and never committed or printed.
# The real file must be mode 600, owned by root:   chmod 600 /opt/marketripple/.env
# compose.yml fixes DATABASE_URL, REDIS_URL, PORT, JSON_LOGS and RAILWAY_ENVIRONMENT itself; do not set them here.

# ── Safety switch ────────────────────────────────────────────────────────────────────────────────────────────
# 1 = no background jobs (use for the dry run and for restoring a database). Remove the line, or set 0, only at cutover.
DISABLE_SCHEDULER=1

# ── Site / access ────────────────────────────────────────────────────────────────────────────────────────────
FRONTEND_URL=https://www.marketripple.in
ADMIN_API_KEY=
REVALIDATE_SECRET=
AEV2_TELEMETRY_KEY=

# ── AI providers (free tiers are shared and capacity-limited; see the capacity audit) ──────────────────────────
GROQ_API_KEY=
CEREBRAS_API_KEY=
GEMINI_API_KEY=
MISTRAL_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_BASE_URL=
ZAI_API_KEY=
NVIDIA_API_KEY=
NVIDIA_BASE_URL=
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=
OPENAI_API_KEY=
OMNIROUTE_URL=
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=

# ── Market data ────────────────────────────────────────────────────────────────────────────────────────────
FINNHUB_API_KEY=
FYERS_CLIENT_ID=
FYERS_SECRET_KEY=
FYERS_ACCESS_TOKEN=
FYERS_PIN=
FYERS_TOTP_KEY=

# ── Off-box database backup (Railway Bucket, S3-compatible). The app's remote_backup job uploads here. ──────────
BACKUP_BUCKET_ENDPOINT=
BACKUP_BUCKET_REGION=
BACKUP_BUCKET_NAME=
BACKUP_BUCKET_ACCESS_KEY_ID=
BACKUP_BUCKET_SECRET_ACCESS_KEY=

# ── Mail ───────────────────────────────────────────────────────────────────────────────────────────────────
HOSTINGER_MAIL_API_TOKEN=
